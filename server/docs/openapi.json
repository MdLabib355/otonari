{
  "openapi": "3.0.3",
  "info": {
    "title": "Otonari API",
    "version": "3.0.0",
    "description": "Multilingual neighborhood item-sharing platform (English, Japanese, Easy Japanese, Bengali). All neighbor communication uses structured phrase keys translated in the viewer's language — zero free-text chat, zero personal room numbers."
  },
  "servers": [
    { "url": "/", "description": "Current server" }
  ],
  "tags": [
    { "name": "System", "description": "Health check, OpenAPI specification, and uploaded photos" },
    { "name": "Groups & Residents", "description": "Group lookup, resident onboarding, profile, neighborhood stats, device transfer, and leaving" },
    { "name": "Building Manager", "description": "Building manager authentication, group setup, join code rotation, resident approval/moderation, lost-phone restore, and issue visibility" },
    { "name": "Shelf & Items", "description": "Neighborhood shelf listing, item creation with optional EXIF-stripped photo, editing, pausing, and removal" },
    { "name": "Loans", "description": "Borrow requests, lifecycle transitions, condition photos, polite nudges, quick replies, structured issue reports, and thank-you stamps" },
    { "name": "Notifications", "description": "3-Layer notification pipeline: persistent unread inbox, authenticated Server-Sent Events (SSE), and background Web Push (VAPID)" },
    { "name": "Demo", "description": "Available only when DEMO_MODE=true for hackathon demonstrations" }
  ],
  "components": {
    "securitySchemes": {
      "ResidentBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Resident opaque UUID token returned by POST /api/join, POST /api/restore, or POST /api/demo/login."
      },
      "ManagerBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Building manager session UUID token returned by POST /api/manager/register, POST /api/manager/login, or POST /api/demo/manager-login."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        }
      },
      "Group": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "code": { "type": "string", "example": "SAKURA-2611" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["building", "block"] },
          "city": { "type": "string" },
          "require_approval": { "type": "boolean" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "group_id": { "type": "integer" },
          "nickname": { "type": "string" },
          "lang": { "type": "string", "enum": ["en", "ja", "ja-easy", "bn"] },
          "elder_mode": { "type": "boolean" },
          "status": { "type": "string", "enum": ["pending", "approved", "rejected"] }
        }
      },
      "Manager": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" }
        }
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "item_key": { "type": "string", "example": "takoyaki_maker" },
          "max_days": { "type": "integer", "enum": [1, 2, 3, 7] },
          "spot": { "type": "string", "enum": ["entrance", "mailbox", "bike_parking", "notice_board", "konbini"] },
          "trusted_only": { "type": "boolean" },
          "paused": { "type": "boolean" },
          "photo_url": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["available", "reserved", "lent"] }
        }
      },
      "TransferCode": {
        "type": "object",
        "properties": {
          "code": { "type": "string", "example": "ABCD-2345" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health check and demo mode flag",
        "responses": {
          "200": { "description": "Server and PostgreSQL healthy" },
          "503": { "description": "Database unreachable" }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["System"],
        "summary": "Raw OpenAPI 3.0.3 JSON specification",
        "responses": { "200": { "description": "OpenAPI JSON document" } }
      }
    },
    "/uploads/{filename}": {
      "get": {
        "tags": ["System"],
        "summary": "Serve an EXIF-stripped uploaded photo",
        "parameters": [
          { "name": "filename", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Image binary with X-Content-Type-Options: nosniff" },
          "404": { "description": "Not found or invalid UUID filename" }
        }
      }
    },
    "/api/groups/by-code/{code}": {
      "get": {
        "tags": ["Groups & Residents"],
        "summary": "Look up a neighborhood group by its join code",
        "parameters": [
          { "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Group preview with active member count and require_approval flag" },
          "404": { "description": "Group not found" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/join": {
      "post": {
        "tags": ["Groups & Residents"],
        "summary": "Join a neighborhood group with nickname and language",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code", "nickname", "lang"],
                "properties": {
                  "code": { "type": "string" },
                  "nickname": { "type": "string", "minLength": 1, "maxLength": 20 },
                  "lang": { "type": "string", "enum": ["en", "ja", "ja-easy", "bn"] },
                  "manager_note": { "type": "string", "maxLength": 40 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Joined (status 'approved' or 'pending' if building requires approval)" },
          "400": { "description": "Validation error" },
          "404": { "description": "Group not found" },
          "409": { "description": "Duplicate active nickname in this group" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/restore": {
      "post": {
        "tags": ["Groups & Residents"],
        "summary": "Redeem a 10-minute single-use device transfer or lost-phone restore code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["code"],
                "properties": { "code": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Restored { token, user, group }" },
          "400": { "description": "Code missing" },
          "404": { "description": "Code invalid, expired, or already used" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/me/transfer-code": {
      "post": {
        "tags": ["Groups & Residents"],
        "summary": "Generate a 10-minute single-use code to sign into the same resident account on another device",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "201": { "description": "Transfer code created" },
          "401": { "description": "Unauthorized" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": ["Groups & Residents"],
        "summary": "Get current resident profile and group (allowed while pending approval)",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "200": { "description": "{ user, group }" },
          "401": { "description": "Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Groups & Residents"],
        "summary": "Update language or elder_mode",
        "security": [{ "ResidentBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lang": { "type": "string", "enum": ["en", "ja", "ja-easy", "bn"] },
                  "elder_mode": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated { user, group }" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/group/stats": {
      "get": {
        "tags": ["Groups & Residents"],
        "summary": "Neighborhood connection statistics (members, items, completed & cross-language loans)",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "200": { "description": "{ members, items, completed_loans, cross_language_loans }" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/leave": {
      "post": {
        "tags": ["Groups & Residents"],
        "summary": "Leave the neighborhood group (blocked while accepted/active loans exist)",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "204": { "description": "Left group; available items removed and pending loans cleaned up" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "Cannot leave while accepted or active loans remain" }
        }
      }
    },
    "/api/manager/register": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Create a building manager account (scrypt password hashing)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "password"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8, "maxLength": 128 }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "{ token, manager }" },
          "400": { "description": "Validation error" },
          "409": { "description": "Email already registered" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/manager/login": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Sign in as a building manager (creates a multi-device session)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ token, manager }" },
          "400": { "description": "Missing credentials" },
          "401": { "description": "Invalid email or password" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/manager/me": {
      "get": {
        "tags": ["Building Manager"],
        "summary": "Get manager profile and owned neighborhood groups with counts",
        "security": [{ "ManagerBearerAuth": [] }],
        "responses": {
          "200": { "description": "{ manager, groups }" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/manager/logout": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Sign out the current manager session token",
        "security": [{ "ManagerBearerAuth": [] }],
        "responses": {
          "204": { "description": "Session revoked" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/groups": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Create a new building or block group (manager auth required)",
        "security": [{ "ManagerBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "type", "city"],
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 60 },
                  "type": { "type": "string", "enum": ["building", "block"] },
                  "city": { "type": "string", "minLength": 1, "maxLength": 40 },
                  "require_approval": { "type": "boolean" },
                  "create_anyway": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Group created with unique join code" },
          "400": { "description": "Validation error" },
          "401": { "description": "Unauthorized" },
          "409": { "description": "NFKC-similar group exists in same city (pass create_anyway: true to confirm)" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/manager/groups/{id}": {
      "patch": {
        "tags": ["Building Manager"],
        "summary": "Toggle require_approval setting for an owned group",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["require_approval"],
                "properties": { "require_approval": { "type": "boolean" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated group settings" },
          "400": { "description": "Validation error" },
          "403": { "description": "Not your group" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/api/manager/groups/{id}/rotate-code": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Generate a new join code (existing residents remain logged in)",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Group with rotated join code" },
          "403": { "description": "Not your group" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/api/manager/groups/{id}/members": {
      "get": {
        "tags": ["Building Manager"],
        "summary": "List pending join requests (with private manager_note) and active residents",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "{ pending, active }" },
          "403": { "description": "Not your group" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/api/manager/groups/{id}/members/{userId}/approve": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Approve a pending resident join request (pushes instant SSE unlock)",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Resident approved" },
          "403": { "description": "Not your group" },
          "404": { "description": "Pending member not found" }
        }
      }
    },
    "/api/manager/groups/{id}/members/{userId}/reject": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Reject a pending resident join request",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Resident rejected" },
          "403": { "description": "Not your group" },
          "404": { "description": "Pending member not found" }
        }
      }
    },
    "/api/manager/groups/{id}/members/{userId}/remove": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Safely remove a resident (blocked 409 if an item is physically lent out)",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Resident removed and SSE stream disconnected" },
          "403": { "description": "Not your group" },
          "404": { "description": "Member not found" },
          "409": { "description": "Blocked while an item is currently lent out or mid-handover" }
        }
      }
    },
    "/api/manager/groups/{id}/members/{userId}/transfer-code": {
      "post": {
        "tags": ["Building Manager"],
        "summary": "Issue a 10-minute lost-phone restore code (rotates resident token and logs out lost device)",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "userId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "201": { "description": "Restore code created and old device session revoked" },
          "403": { "description": "Not your group" },
          "404": { "description": "Active member not found" }
        }
      }
    },
    "/api/manager/groups/{id}/issues": {
      "get": {
        "tags": ["Building Manager"],
        "summary": "List structured item issue/damage reports in an owned group",
        "security": [{ "ManagerBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Array of structured issue reports with optional photo URLs" },
          "403": { "description": "Not your group" },
          "404": { "description": "Group not found" }
        }
      }
    },
    "/api/shelf": {
      "get": {
        "tags": ["Shelf & Items"],
        "summary": "List all active items on the resident's neighborhood shelf",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "200": { "description": "Array of shelf items" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/my-items": {
      "get": {
        "tags": ["Shelf & Items"],
        "summary": "List items owned by the current resident",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "200": { "description": "Array of owned items" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/items/{id}": {
      "get": {
        "tags": ["Shelf & Items"],
        "summary": "Get item details, owner info, trust eligibility, and caller's open loan ID",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Item detail object" },
          "403": { "description": "Item belongs to another neighborhood" },
          "404": { "description": "Item not found" }
        }
      },
      "patch": {
        "tags": ["Shelf & Items"],
        "summary": "Update item max_days, spot, paused, or trusted_only (owner only)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "max_days": { "type": "integer", "enum": [1, 2, 3, 7] },
                  "spot": { "type": "string" },
                  "paused": { "type": "boolean" },
                  "trusted_only": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Updated" },
          "400": { "description": "Validation error" },
          "403": { "description": "Not your item" },
          "404": { "description": "Item not found" }
        }
      },
      "delete": {
        "tags": ["Shelf & Items"],
        "summary": "Soft-delete an available item and decline waiting requests",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "204": { "description": "Removed" },
          "403": { "description": "Not your item" },
          "404": { "description": "Item not found" },
          "409": { "description": "Cannot remove while reserved or lent" }
        }
      }
    },
    "/api/items": {
      "post": {
        "tags": ["Shelf & Items"],
        "summary": "Add an item to the shelf (JSON or multipart/form-data with optional EXIF-stripped photo; max 50 active items/user)",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "201": { "description": "Created item" },
          "400": { "description": "Validation error or invalid image" },
          "409": { "description": "Maximum 50 active items per resident reached" },
          "413": { "description": "Photo exceeds 5 MB limit" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/loans": {
      "get": {
        "tags": ["Loans"],
        "summary": "List resident's loans grouped by borrowing and lending",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "200": { "description": "{ borrowing, lending }" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": ["Loans"],
        "summary": "Submit a borrow request for an available, unpaused item",
        "security": [{ "ResidentBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["item_id", "start_at", "end_at"],
                "properties": {
                  "item_id": { "type": "integer" },
                  "start_at": { "type": "string", "format": "date-time" },
                  "end_at": { "type": "string", "format": "date-time" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Loan details with initial request message" },
          "400": { "description": "Invalid dates or duration" },
          "403": { "description": "Wrong group or trusted-only restriction" },
          "404": { "description": "Item not found" },
          "409": { "description": "Item paused, unavailable, or duplicate request" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/loans/{id}": {
      "get": {
        "tags": ["Loans"],
        "summary": "Get full loan details, participants, borrower trust, and structured message thread",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Loan thread details" },
          "403": { "description": "Not a participant" },
          "404": { "description": "Loan not found" }
        }
      }
    },
    "/api/loans/{id}/accept": {
      "post": {
        "tags": ["Loans"],
        "summary": "Accept a pending borrow request (lender only; reserves item and declines competing pending requests)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Updated loan details" }, "409": { "description": "Invalid state" } }
      }
    },
    "/api/loans/{id}/decline": {
      "post": {
        "tags": ["Loans"],
        "summary": "Decline a pending borrow request (lender only)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "reason": { "type": "string", "enum": ["default", "busy"] } }
              }
            }
          }
        },
        "responses": { "200": { "description": "Updated loan details" }, "409": { "description": "Invalid state" } }
      }
    },
    "/api/loans/{id}/cancel": {
      "post": {
        "tags": ["Loans"],
        "summary": "Cancel a pending request (borrower) or accepted loan before handover photo (either side)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Updated loan details" }, "409": { "description": "Invalid state" } }
      }
    },
    "/api/loans/{id}/handover": {
      "post": {
        "tags": ["Loans"],
        "summary": "Upload EXIF-stripped handover condition photo (lender only)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Updated loan details" },
          "400": { "description": "Invalid image" },
          "409": { "description": "Invalid state" },
          "413": { "description": "Photo exceeds 5 MB" }
        }
      }
    },
    "/api/loans/{id}/received": {
      "post": {
        "tags": ["Loans"],
        "summary": "Confirm item received after handover photo (borrower only; marks loan active)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Updated loan details" }, "409": { "description": "Invalid state" } }
      }
    },
    "/api/loans/{id}/return": {
      "post": {
        "tags": ["Loans"],
        "summary": "Upload EXIF-stripped return condition photo (borrower only)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Updated loan details" },
          "400": { "description": "Invalid image" },
          "409": { "description": "Invalid state" },
          "413": { "description": "Photo exceeds 5 MB" }
        }
      }
    },
    "/api/loans/{id}/return-confirmed": {
      "post": {
        "tags": ["Loans"],
        "summary": "Confirm item returned after return photo (lender only; frees item)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "Updated loan details" }, "409": { "description": "Invalid state" } }
      }
    },
    "/api/loans/{id}/ping": {
      "post": {
        "tags": ["Loans"],
        "summary": "Send a polite return reminder to the borrower (lender only, per-loan cooldown)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Updated loan details" },
          "409": { "description": "Loan not active or already has return photo" },
          "429": { "description": "Cooldown active (see Retry-After header)" }
        }
      }
    },
    "/api/loans/{id}/quick-reply": {
      "post": {
        "tags": ["Loans"],
        "summary": "Send a fixed translated quick reply",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["phrase_key"],
                "properties": {
                  "phrase_key": {
                    "type": "string",
                    "enum": ["qr.onMyWay", "qr.atSpot", "qr.late", "qr.noProblem", "qr.thanks"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated loan details" },
          "400": { "description": "Unknown quick reply" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/loans/{id}/issue": {
      "post": {
        "tags": ["Loans"],
        "summary": "Report a structured non-confrontational item issue/damage with optional EXIF-stripped photo",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "Updated loan details" },
          "400": { "description": "Unknown issue_key or invalid photo" },
          "409": { "description": "Only allowed on active or returned loans" },
          "413": { "description": "Photo exceeds 5 MB" }
        }
      }
    },
    "/api/loans/{id}/stamp": {
      "post": {
        "tags": ["Loans"],
        "summary": "Send a warm Japanese thank-you stamp on a completed (returned) loan",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["stamp_key"],
                "properties": {
                  "stamp_key": {
                    "type": "string",
                    "enum": ["stamp.bigThanks", "stamp.clean", "stamp.snack", "stamp.anytime"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Updated loan details" },
          "400": { "description": "Unknown stamp_key" },
          "409": { "description": "Only allowed on returned loans" }
        }
      }
    },
    "/api/inbox": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Layer 1: Fetch all piled-up unread notifications (oldest first)",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": { "200": { "description": "Array of unread structured messages" } }
      }
    },
    "/api/inbox/read": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Mark specific unread messages as read",
        "security": [{ "ResidentBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["ids"],
                "properties": {
                  "ids": { "type": "array", "items": { "type": "integer" } }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "{ updated }" }, "400": { "description": "Invalid ids" } }
      }
    },
    "/api/inbox/read-all": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Mark all unread notifications as read",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": { "200": { "description": "{ updated }" } }
      }
    },
    "/api/due-loans": {
      "get": {
        "tags": ["Notifications"],
        "summary": "List active borrowed loans due within 24 hours or overdue without a return photo",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": { "200": { "description": "Array of due/overdue loans" } }
      }
    },
    "/api/events": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Layer 2: Authenticated Server-Sent Events (SSE) live stream (max 5 streams per resident)",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": {
          "200": { "description": "text/event-stream emitting connected, update, and revoked events" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/push/vapid-key": {
      "get": {
        "tags": ["Notifications"],
        "summary": "Layer 3: Get the server's auto-persisted VAPID public key for browser PushManager",
        "security": [{ "ResidentBearerAuth": [] }],
        "responses": { "200": { "description": "{ publicKey }" } }
      }
    },
    "/api/push/subscribe": {
      "post": {
        "tags": ["Notifications"],
        "summary": "Layer 3: Register or update a browser Web Push subscription",
        "security": [{ "ResidentBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["endpoint", "keys"],
                "properties": {
                  "endpoint": { "type": "string", "format": "uri" },
                  "keys": {
                    "type": "object",
                    "required": ["p256dh", "auth"],
                    "properties": {
                      "p256dh": { "type": "string" },
                      "auth": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": { "201": { "description": "{ ok: true }" }, "400": { "description": "Invalid subscription" } }
      },
      "delete": {
        "tags": ["Notifications"],
        "summary": "Layer 3: Unregister a browser Web Push subscription",
        "security": [{ "ResidentBearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["endpoint"],
                "properties": { "endpoint": { "type": "string" } }
              }
            }
          }
        },
        "responses": { "204": { "description": "Subscription removed" }, "400": { "description": "Missing endpoint" } }
      }
    },
    "/api/demo/users": {
      "get": {
        "tags": ["Demo"],
        "summary": "List seeded demo neighbors (DEMO_MODE=true only)",
        "responses": { "200": { "description": "Array of demo users" } }
      }
    },
    "/api/demo/login": {
      "post": {
        "tags": ["Demo"],
        "summary": "Sign in as a seeded demo neighbor (DEMO_MODE=true only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["user_id"],
                "properties": { "user_id": { "type": "integer" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "{ token, user, group }" },
          "403": { "description": "Target user is not a demo account" },
          "404": { "description": "User not found" }
        }
      }
    },
    "/api/demo/manager-login": {
      "post": {
        "tags": ["Demo"],
        "summary": "Sign in as the seeded demo building manager (DEMO_MODE=true only)",
        "responses": {
          "200": { "description": "{ token, manager }" },
          "404": { "description": "Demo manager not found" }
        }
      }
    },
    "/api/demo/fast-forward/{loanId}": {
      "post": {
        "tags": ["Demo"],
        "summary": "Shift an active loan's timestamps to dueSoon or overdue and trigger reminders (DEMO_MODE=true only)",
        "security": [{ "ResidentBearerAuth": [] }],
        "parameters": [{ "name": "loanId", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["to"],
                "properties": { "to": { "type": "string", "enum": ["dueSoon", "overdue"] } }
              }
            }
          }
        },
        "responses": {
          "204": { "description": "Timestamps shifted and reminders checked" },
          "403": { "description": "Not a loan participant" },
          "409": { "description": "Loan is not active" }
        }
      }
    }
  }
}
