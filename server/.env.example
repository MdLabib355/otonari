# Copy this file to .env in this same folder (server/.env). Never commit .env: it holds secrets.
# Docker reads server/.env too, except for PORT, DEMO_MODE and DATABASE_URL (see docker-compose.yml).
PORT=3001
DEMO_MODE=true
# The database of `npm run db`
DATABASE_URL=postgres://otonari:otonari@localhost:5433/otonari

# Optional: remove the "# " in front of the settings you want to use.

# The first super admin. Choose your own password (at least 8 characters).
# SUPER_ADMIN_EMAIL=admin@example.com
# SUPER_ADMIN_PASSWORD=choose-your-own-password

# Emails with the 6-digit code. Gmail: smtp.gmail.com, 587, and an "app password". Without it, Docker uses its test mailbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-gmail-app-password
# SMTP_FROM=your-address@gmail.com

# "Continue with Google": the OAuth client ID (Web application) from console.cloud.google.com. Add the address
# of the app, e.g. http://localhost:8088, as an "Authorized JavaScript origin". Empty = no Google button.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Photos in a private AWS S3 bucket. The key needs only s3:PutObject, s3:GetObject and s3:DeleteObject on <bucket>/photos/*.
# Empty S3_BUCKET = photos in server/uploads.
# S3_BUCKET=your-bucket-name
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Signs the super admin's short emergency access to a disputed loan. Any long random text. Empty = a new one at every start.
# BREAK_GLASS_SECRET=any-long-random-text
