# Copy this file to .env in this same folder (server/.env). Never commit .env: it holds secrets.
# Docker reads server/.env too, except for PORT, DEMO_MODE and DATABASE_URL (see docker-compose.yml).
PORT=3001
DEMO_MODE=true
# The database of `npm run db`
DATABASE_URL=postgres://otonari:otonari@localhost:5433/otonari

# The first super admin. Choose your own password (at least 8 characters).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Emails with the 6-digit code. Gmail: smtp.gmail.com, 587, and an "app password". Empty = no codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# "Continue with Google": the OAuth client ID (Web application) from console.cloud.google.com. Add the address
# of the app, e.g. http://localhost:8088, as an "Authorized JavaScript origin". Empty = no Google button.
GOOGLE_CLIENT_ID=
