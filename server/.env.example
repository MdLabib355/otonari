# Copy this file to .env in this same folder (server/.env).
# Start local PostgreSQL with: docker compose up -d db
PORT=3001
DATABASE_URL=postgres://otonari:otonari@localhost:5432/otonari
# Optional: set to 'true' if your PostgreSQL host requires TLS without a custom CA
# DATABASE_SSL=true
# Optional: directory for uploaded photos (defaults to server/uploads; use /data/uploads on Railway Volume)
# UPLOADS_DIR=/data/uploads
# Optional: Web Push VAPID keys (if omitted, generated once and persisted automatically in PostgreSQL app_settings)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:noreply@otonari.local
DEMO_MODE=true
