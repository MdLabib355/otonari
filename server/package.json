{
  "name": "otonari-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon index.ts",
    "typecheck": "tsc"
  },
  "nodemonConfig": {
    "watch": [
      "."
    ],
    "ext": "ts",
    "execMap": {
      "ts": "node"
    },
    "ignore": [
      "node_modules/",
      "uploads/"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
